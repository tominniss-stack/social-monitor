# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/community_dashboard?schema=public"

# Meta Graph API (System User Token & App Credentials)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_custom_verify_token_string"
META_SYSTEM_USER_ACCESS_TOKEN="your_non_expiring_system_user_token"
META_GRAPH_API_VERSION="v21.0"

# Per-account Meta token encryption at rest (AES-256-GCM, src/lib/crypto.ts).
# 32 bytes as hex — generate with:  openssl rand -hex 32
# Only required once a PlatformAccount.accessToken is stored; demo mode works without it.
TOKEN_ENCRYPTION_KEY=""

# OpenAI API
OPENAI_API_KEY="sk-..."
# Daily OpenAI spend guard: max LLM/embedding calls per UTC day across triage, tone,
# clustering and embeddings (default 500). Over budget → deterministic fallbacks / 429 on tone.
LLM_DAILY_CALL_LIMIT="500"

# App / Queue Config
NEXT_PUBLIC_APP_URL="http://localhost:3005"
# Inngest: keep "local" for the dev server (npx inngest-cli@latest dev). If no dev
# server is running, the webhook route falls back to direct in-process execution.
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"
# Bearer secret for /api/cron/reconcile — the placeholder value is rejected (401).
CRON_SECRET="your_cron_secret"

# Authentication
# AUTH_PROVIDER: cloudflare-access | dev  (authjs reserved for a future swap).
# Defaults to "cloudflare-access" in production and "dev" otherwise. "dev" is refused in production.
AUTH_PROVIDER="cloudflare-access"
CF_ACCESS_TEAM_DOMAIN=""                   # e.g. your-team.cloudflareaccess.com (required for cloudflare-access)
CF_ACCESS_AUD=""                           # Application Audience (AUD) tag from the Access dashboard
DEV_USER_EMAIL="dev@localhost"             # only honoured when AUTH_PROVIDER=dev

# Webhook simulator — always on outside production; must be "true" to enable in production
ENABLE_SIMULATOR="true"
